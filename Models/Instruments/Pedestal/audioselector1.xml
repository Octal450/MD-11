<PropertyList>
	
    <path>audioselector.ac</path>
	
	<animation>
		<type>material</type>
		<object-name>audioselector.text</object-name>
		<emission>
			<red>1.0</red>
			<green>0.85</green>
			<blue>0.6</blue>
			<factor-prop>systems/lighting/main-integ</factor-prop>
		</emission>
	</animation>
	
	<effect>
		<inherits-from>Effects/model-transparent</inherits-from>
		<object-name>audioselector.text</object-name>
	</effect>
	
	<animation>
		<type>material</type>
		<object-name>Lights</object-name>
		<emission>
			<red>1.0</red>
			<green>1.0</green>
			<blue>1.0</blue>
			<factor-prop>systems/lighting/annunciator-brightness</factor-prop>
		</emission>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>Lights</object-name>
		<condition>
			<greater-than-equals>
				<property>systems/electrical/outputs/acp[0]</property>
				<value>24</value>
			</greater-than-equals>
		</condition>
	</animation>
	
	<!-- Buttons -->
	<animation>
		<type>pick</type>
		<object-name>Vhf1</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>instrumentation/acp/mic</property>
				<value>0</value>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>controls/cockpit/acp[0]/vhf-1</property>
				<value>1</value>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.btn2();</script>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/cockpit/acp[0]/vhf-1</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>Vhf1</object-name>
		<object-name>Vhf1.call</object-name>
		<object-name>Vhf1.mic</object-name>
		<property>controls/cockpit/acp[0]/vhf-1</property>
		<factor>-0.001</factor>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>Vhf2</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>instrumentation/acp/mic</property>
				<value>1</value>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>controls/cockpit/acp[0]/vhf-2</property>
				<value>1</value>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.btn2();</script>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/cockpit/acp[0]/vhf-2</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>Vhf2</object-name>
		<object-name>Vhf2.call</object-name>
		<object-name>Vhf2.mic</object-name>
		<property>controls/cockpit/acp[0]/vhf-2</property>
		<factor>-0.001</factor>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>Vhf3</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>instrumentation/acp/mic</property>
				<value>2</value>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>controls/cockpit/acp[0]/vhf-3</property>
				<value>1</value>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.btn2();</script>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/cockpit/acp[0]/vhf-3</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>Vhf3</object-name>
		<object-name>Vhf3.call</object-name>
		<object-name>Vhf3.mic</object-name>
		<property>controls/cockpit/acp[0]/vhf-3</property>
		<factor>-0.001</factor>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>Int</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>instrumentation/acp/mic</property>
				<value>6</value>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>controls/cockpit/acp[0]/int</property>
				<value>1</value>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.btn2();</script>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/cockpit/acp[0]/int</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>Int</object-name>
		<object-name>Int.call</object-name>
		<object-name>Int.mic</object-name>
		<property>controls/cockpit/acp[0]/int</property>
		<factor>-0.001</factor>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>Cab</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>instrumentation/acp/mic</property>
				<value>7</value>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>controls/cockpit/acp[0]/cab</property>
				<value>1</value>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.btn2();</script>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/cockpit/acp[0]/cab</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>Cab</object-name>
		<object-name>Cab.call</object-name>
		<object-name>Cab.mic</object-name>
		<property>controls/cockpit/acp[0]/cab</property>
		<factor>-0.001</factor>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>Ident</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-toggle</command>
				<property>instrumentation/acp[0]/ident</property>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>controls/cockpit/acp[0]/ident</property>
				<value>1</value>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.btn2();</script>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/cockpit/acp[0]/ident</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>Ident</object-name>
		<object-name>Ident.on</object-name>
		<property>controls/cockpit/acp[0]/ident</property>
		<factor>-0.001</factor>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>
	
	<!-- Lights -->
	<animation>
		<type>select</type>
		<object-name>Ident.on</object-name>
		<condition> <!-- Does not light with annun-test -->
			<equals>
				<property>instrumentation/acp[0]/ident</property>
				<value>4</value>
			</equals>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>Cab.call</object-name>
		<object-name>Hf1.call</object-name>
		<object-name>Hf2.call</object-name>
		<object-name>Int.call</object-name>
		<object-name>Sat.call</object-name>
		<object-name>Vhf1.call</object-name>
		<object-name>Vhf2.call</object-name>
		<object-name>Vhf3.call</object-name>
		<condition>
			<property>controls/switches/annun-test</property>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>Vhf1.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>0</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Vhf2.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Vhf3.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>2</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Hf1.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>3</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Hf2.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>4</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Sat.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>5</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Int.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>6</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>Cab.mic</object-name>
		<condition>
			<or>
				<property>controls/switches/annun-test</property>
				<equals>
					<property>instrumentation/acp[0]/mic</property>
					<value>7</value>
				</equals>
			</or>
		</condition>
	</animation>

</PropertyList>
