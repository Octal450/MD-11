<PropertyList>
	
    <path>audioselector.ac</path>
	
	<animation>
		<type>material</type>
		<object-name>audioselector.text</object-name>
		<emission>
			<red>1.0</red>
			<green>0.85</green>
			<blue>0.6</blue>
			<factor-prop>systems/lighting/main-integ</factor-prop>
		</emission>
	</animation>
	
	<effect>
		<inherits-from>Effects/model-transparent</inherits-from>
		<object-name>audioselector.text</object-name>
	</effect>
	
	<animation>
		<type>material</type>
		<object-name>Lights</object-name>
		<emission>
			<red>1.0</red>
			<green>1.0</green>
			<blue>1.0</blue>
			<factor-prop>systems/lighting/annunciator-brightness</factor-prop>
		</emission>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>Lights</object-name>
		<condition>
			<greater-than-equals>
				<property>systems/electrical/outputs/acp[1]</property>
				<value>24</value>
			</greater-than-equals>
		</condition>
	</animation>
	
	<!-- Buttons -->
	<animation>
		<type>pick</type>
		<object-name>Vhf1</object-name>
