<?xml version="1.0"?>

<!-- McDonnell Douglas MD-11 Pressurization -->
<!-- Copyright (c) 2026 Josh Davidson (Octal450) -->

<system name="MD-11: Pressurization">
	
	<property value="14.7">/systems/pressurization/cabin-psi</property> <!-- Should this be set to environment pressure on simload? -->
	<property value="1">/systems/pressurization/outflow-valve/auto-cmd</property>
	
	<channel name="CPCS Switches/Logic" execrate="8">
		
		<switch name="/systems/pressurization/system">
			<default value="/controls/pressurization/system"/>
			<test value="0">
				/systems/failures/pressurization/system eq 1
			</test>
		</switch>
	
	</channel>
	
	<channel name="Outflow Valve" execrate="8">
		
		<fcs_function name="/systems/pressurization/outflow-valve/cmd">
			<function>
				<ifthen>
					<eq>
						<property>/systems/pressurization/system</property>
						<value>1</value>
					</eq>
					<property>/systems/pressurization/outflow-valve/auto-cmd</property>
					<sum>
						<property>/systems/pressurization/outflow-valve/cmd</property>
						<product>
							<property>/controls/pressurization/cabin-manual</property>
							<value>0.01</value>
						</product>
					</sum>
				</ifthen>
			</function>
			<clipto>
				<min>0.0</min>
				<max>1.0</max>
			</clipto>
		</fcs_function>
		
		<actuator name="/systems/pressurization/outflow-valve/pos">
			<input>/systems/pressurization/outflow-valve/cmd</input>
			<rate_limit>0.25</rate_limit>
		</actuator>
	
	</channel>
	
	<channel name="Cabin Pressure" execrate="8">
		
		<pure_gain name="/systems/pressurization/environment-psi">
			<input>/environment/pressure-inhg</input>
			<gain>0.491154</gain>
		</pure_gain>
		
		<summer name="/systems/pressurization/cabin-diff-psi">
			<input>/systems/pressurization/cabin-psi</input>
			<input>-/systems/pressurization/environment-psi</input>
		</summer>
		
		<pure_gain name="/systems/pressurization/outflow-psi-error">
			<input>/systems/pressurization/cabin-diff-psi</input>
			<gain>1.0</gain>
		</pure_gain>
		
		<fcs_function name="/systems/pressurization/outflow-psi-rate">
			<function>
				<product>
					<pow> <!-- Flow isn't linear -->
						<property>/systems/pressurization/outflow-valve/pos</property>
						<value>2</value>
					</pow>
					<value>-0.008</value>
				</product>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/pack-psi">
			<function>
				<sum>
					<min>
						<property>/systems/pressurization/cabin-psi</property>
						<value>15.82</value>
					</min>
					<value>4</value>
				</sum>
			</function>
		</fcs_function>
		
		<summer name="/systems/pressurization/pack-flow-sum">
			<input>/systems/pneumatics/pack-1-flow</input>
			<input>/systems/pneumatics/pack-2-flow</input>
			<input>/systems/pneumatics/pack-3-flow</input>
			<clipto>
				<min>0</min>
				<max>24</max>
			</clipto>
		</summer>
		
		<summer name="/systems/pressurization/pack-psi-error">
			<input>/systems/pressurization/cabin-psi</input>
			<input>-/systems/pressurization/pack-psi</input>
			<clipto> <!-- It can never depressurize -->
				<min>-100</min>
				<max>0.0</max>
			</clipto>
		</summer>
		
		<fcs_function name="/systems/pressurization/pack-psi-rate">
			<function>
				<product>
					<difference>
						<value>1</value>
						<pow> <!-- Flow isn't linear -->
							<property>/systems/pressurization/outflow-valve/pos</property>
							<value>2</value>
						</pow>
					</difference>
					<table>
						<independentVar lookup="row">/systems/pressurization/pack-flow-sum</independentVar>
						<tableData>
							 0  0
							24  1
						</tableData>
					</table>
					<value>-0.004</value>
				</product>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cabin-psi-calc">
			<function>
				<sum>
					<property>/systems/pressurization/cabin-psi</property>
					<product> <!-- Outflow factor -->
						<property>/systems/pressurization/outflow-psi-error</property>
						<property>/systems/pressurization/outflow-psi-rate</property>
						<property>simulation/channel-dt</property>
					</product>
					<product> <!-- Packs factor -->
						<property>/systems/pressurization/pack-psi-error</property>
						<property>/systems/pressurization/pack-psi-rate</property>
						<property>simulation/channel-dt</property>
					</product>
				</sum>
			</function>
			<output>/systems/pressurization/cabin-psi</output>
			<clipto> <!-- Keep it reasonable -->
				<min>1.0</min>
				<max>30</max>
			</clipto>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cabin-alt-ft">
			<function>
				<product>
					<value>145366.45</value>
					<difference>
						<value>1</value>
						<pow>
							<quotient>
								<property>/systems/pressurization/cabin-psi</property>
								<value>14.6959</value>
							</quotient>
							<value>0.190284</value>
						</pow>
					</difference>
				</product>
			</function>
		</fcs_function>
		
		<pid name="/systems/pressurization/cabin-rate-fps">
			<descripton>Use D only to calculate rate</descripton>
			<input>/systems/pressurization/cabin-alt-ft</input>
			<kp>0.0</kp>
			<ki>0.0</ki>
			<kd>1.0</kd>
		</pid>
		
		<pure_gain name="/systems/pressurization/cabin-rate-fpm-raw">
			<input>/systems/pressurization/cabin-rate-fps</input>
			<gain>60</gain>
			<clipto> <!-- Keep it sane -->
				<min>-9990</min>
				<max>9990</max>
			</clipto>
		</pure_gain>
		
		<lag_filter name="/systems/pressurization/cabin-rate-fpm">
			<input>/systems/pressurization/cabin-rate-fpm-raw</input>
			<c1>5.0</c1>
		</lag_filter>
	
	</channel>
	
	<channel name="Overhead/Synoptic Lights">
		
		<switch name="/systems/pressurization/lights/outflow-closed">
			<default value="0"/>
			<test value="1">
				/systems/pressurization/outflow-valve/pos lt 0.001
			</test>
		</switch>
	
	</channel>

</system>
