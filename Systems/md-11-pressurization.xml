<?xml version="1.0"?>

<!-- McDonnell Douglas MD-11 Pressurization -->
<!-- Copyright (c) 2026 Josh Davidson (Octal450) -->

<system name="MD-11: Pressurization">
	
	<property value="14.7">/systems/pressurization/cabin-psi</property>
	<property value="0">/systems/pressurization/cabin-rate-fpm</property>
	<property value="1">/systems/pressurization/outflow-valve/auto-cmd</property> <!-- Start open -->
	<property value="1">/systems/pressurization/outflow-valve/cmd</property> <!-- Start open -->
	
	<channel name="CPCS Logic" execrate="8">
		
		<switch name="/systems/pressurization/system">
			<default value="/controls/pressurization/system"/>
			<test value="0">
				/systems/failures/pressurization/system eq 1
			</test>
		</switch>
		
		<switch name="/systems/pressurization/cpcs/takeoff-alt">
			<default value="/systems/pressurization/cpcs/takeoff-alt"/> <!-- Memorize on slat extend if no FMS data -->
			<test value="/systems/fms/flight-data/airport-from-alt"> <!-- FMS data available -->
				/systems/fms/flight-data/airport-from-alt gt -2000
			</test>
			<test logic="AND" value="/instrumentation/altimeter/indicated-altitude-ft"> <!-- Update before slat extend if no FMS data -->
				/systems/fms/internal/phase eq 0
				fcs/slat-pos-deg lt 0.1
			</test>
		</switch>
		
		<switch name="/systems/pressurization/cpcs/manual-landing-alt-set">
			<default value="0"/>
			<test value="1">
				/controls/pressurization/manual-landing-alt-set eq 1
			</test>
		</switch>
		
		<switch name="/systems/pressurization/cpcs/landing-alt-indicated">
			<default value="-2000"/> <!-- Not set -->
			<test value="/controls/pressurization/manual-landing-alt"> <!-- Manually set -->
				/systems/pressurization/cpcs/manual-landing-alt-set eq 1
			</test>
			<test value="/systems/fms/flight-data/airport-to-alt"> <!-- FMS data available -->
				/systems/fms/flight-data/airport-to-alt gt -2000
			</test>
		</switch>
		
		<switch name="/systems/pressurization/cpcs/landing-alt"> <!-- When unset, use 0 -->
			<default value="/systems/pressurization/cpcs/landing-alt-indicated"/> <!-- Set -->
			<test value="0"> <!-- Not set -->
				/systems/pressurization/cpcs/landing-alt-indicated eq -2000
			</test>
		</switch>
	
	</channel>
	
	<channel name="Cabin Differential Pressure" execrate="8">
		
		<pure_gain name="/systems/pressurization/environment-psi">
			<input>/environment/pressure-inhg</input>
			<gain>0.491154</gain>
		</pure_gain>
		
		<summer name="/systems/pressurization/cabin-diff-psi">
			<input>/systems/pressurization/cabin-psi</input>
			<input>-/systems/pressurization/environment-psi</input>
		</summer>
	
	</channel>
	
	<channel name="Cabin Altitude Schedule" execrate="8">
		
		<fcs_function name="/systems/pressurization/cpcs/takeoff-alt-minus-100">
			<function>
				<difference>
					<property>/systems/pressurization/cpcs/takeoff-alt</property>
					<value>100</value>
				</difference>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cpcs/takeoff-alt-plus-500">
			<function>
				<sum>
					<property>/systems/pressurization/cpcs/takeoff-alt</property>
					<value>500</value>
				</sum>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cpcs/landing-alt-schedule">
			<function>
				<max>
					<product> <!-- Lowest cabin alt within 8.6 diff -->
						<value>145366.45</value>
						<difference>
							<value>1</value>
							<pow>
								<quotient>
									<sum>
										<property>/systems/pressurization/environment-psi</property>
										<value>8.6</value>
									</sum>
									<product>
										<property>/instrumentation/altimeter/setting-inhg</property>
										<value>0.4911738</value>
									</product>
								</quotient>
								<value>0.190263</value>
							</pow>
						</difference>
					</product>
					<property>/systems/pressurization/cpcs/landing-alt</property>
				</max>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cpcs/cabin-alt-schedule">
			<function>
				<max>
					<table>
						<independentVar lookup="row">/instrumentation/altimeter/indicated-altitude-ft</independentVar>
						<tableData> <!-- Approaches 8.6 diff max -->
							    0  -600
							 5000   800
							10000  1700
							15000  2400
							20000  3100
							25000  3900
							30000  4800
							35000  5900
							40000  7200
							43200  8000
						</tableData>
					</table>
					<min>
						<ifthen>
							<ge>
								<property>/systems/fms/internal/phase</property>
								<value>4</value>
							</ge>
							<property>/systems/pressurization/cpcs/landing-alt</property>
							<property>/systems/pressurization/cpcs/takeoff-alt-minus-100</property>
						</ifthen>
						<value>8000</value> <!-- Maximum allowed -->
					</min>
				</max>
			</function>
		</fcs_function>
		
		<switch name="/systems/pressurization/cpcs/cabin-alt-target">
			<default value="/systems/pressurization/cpcs/cabin-alt-schedule"/> <!-- Normal Schedule -->
			<test logic="AND" value="/systems/pressurization/cpcs/takeoff-alt-minus-100"> <!-- Prepressurize when slats extend, until 500ft after takeoff -->
				/systems/fms/internal/phase lt 2
				<test logic="OR">
					<test logic="AND">
						position/wow eq 1
						fcs/slat-pos-deg ge 0.1
					</test>
					<test logic="AND">
						/instrumentation/altimeter/indicated-altitude-ft lt /systems/pressurization/cpcs/takeoff-alt-plus-500
						position/wow eq 0
					</test>
				</test>
			</test>
			<test logic="OR" value="/instrumentation/altimeter/indicated-altitude-ft"> <!-- Cabin to current altitude -->
				/systems/fms/internal/phase eq 6
				position/wow eq 1
			</test>
		</switch>
	
	</channel>
	
	<channel name="Automatic Controller" execrate="8">
		
		<summer name="/systems/pressurization/controller/cabin-alt-error">
			<input>/systems/pressurization/cpcs/cabin-alt-target</input>
			<input>-/systems/pressurization/cabin-alt-ft</input>
		</summer>
		
		<pure_gain name="/systems/pressurization/controller/cabin-rate-target">
			<input>/systems/pressurization/controller/cabin-alt-error</input>
			<gain>5</gain>
			<clipto>
				<min>-350</min>
				<max>750</max>
			</clipto>
		</pure_gain>
		
		<summer name="/systems/pressurization/controller/cabin-fpm-error">
			<input>/systems/pressurization/controller/cabin-rate-target</input>
			<input>-/systems/pressurization/cabin-rate-fpm</input>
			<clipto>
				<min>-500</min>
				<max>500</max>
			</clipto>
		</summer>
		
		<pid name="/systems/pressurization/controller/pid">
			<input>/systems/pressurization/controller/cabin-fpm-error</input>
			<kp>0.0005</kp>
			<ki>0</ki> <!-- Not used, using command integrator instead -->
			<kd>0.0001</kd>
			<clipto>
				<min>-0.25</min>
				<max>0.25</max>
			</clipto>
		</pid>
	
	</channel>
	
	<channel name="Outflow Valve" execrate="8">
		
		<switch name="/systems/pressurization/outflow-valve/power">
			<default value="0"/>
			<test logic="OR" value="1">
				/systems/electrical/bus/dc-bat ge 24
				/systems/electrical/bus/ac-1 ge 112
				/systems/electrical/bus/ac-2 ge 112
			</test>
		</switch>
		
		<fcs_function name="/systems/pressurization/outflow-valve/auto-cmd"> <!-- Command integrator -->
			<function>
				<sum>
					<property>/systems/pressurization/outflow-valve/auto-cmd</property>
					<product>
						<property>/systems/pressurization/outflow-valve/power</property>
						<property>/systems/pressurization/controller/pid</property>
						<property>simulation/channel-dt</property>
					</product>
				</sum>
			</function>
			<clipto>
				<min>0</min>
				<max>1</max>
			</clipto>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/outflow-valve/cmd">
			<function>
				<ifthen>
					<eq>
						<property>/systems/pressurization/outflow-valve/power</property>
						<value>1</value>
					</eq>
					<ifthen>
						<eq>
							<property>/systems/pressurization/system</property>
							<value>1</value>
						</eq>
						<property>/systems/pressurization/outflow-valve/auto-cmd</property>
						<sum>
							<property>/systems/pressurization/outflow-valve/cmd</property>
							<product>
								<property>/controls/pressurization/cabin-manual</property>
								<value>0.01</value>
							</product>
						</sum>
					</ifthen>
					<property>/systems/pressurization/outflow-valve/cmd</property>
				</ifthen>
			</function>
			<clipto>
				<min>0</min>
				<max>1</max>
			</clipto>
		</fcs_function>
		
		<switch name="/systems/pressurization/outflow-valve/rate">
			<default value="0"/>
			<test value="0.25">
				/systems/pressurization/outflow-valve/power eq 1
			</test>
		</switch>
		
		<actuator name="/systems/pressurization/outflow-valve/pos">
			<input>/systems/pressurization/outflow-valve/cmd</input>
			<rate_limit>/systems/pressurization/outflow-valve/rate</rate_limit>
		</actuator>
	
	</channel>
	
	<channel name="Relief Valves" execrate="8">
		
		<fcs_function name="/systems/pressurization/relief-valves/overpressure-valve">
			<function>
				<table>
					<independentVar lookup="row">/systems/pressurization/cabin-diff-psi</independentVar>
					<tableData>
						8.81  0
						8.86  1
					</tableData>
				</table>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/relief-valves/underpressure-valve">
			<function>
				<table>
					<independentVar lookup="row">/systems/pressurization/cabin-diff-psi</independentVar>
					<tableData>
						-0.06  1
						-0.01  0
					</tableData>
				</table>
			</function>
		</fcs_function>
	
	</channel>
	
	<channel name="Cabin Pressure" execrate="8">
		
		<fcs_function name="/systems/pressurization/outflow-psi-rate">
			<function>
				<product>
					<pow> <!-- Flow isn't linear -->
						<property>/systems/pressurization/outflow-valve/pos</property>
						<value>2</value>
					</pow>
					<value>-0.009</value>
				</product>
			</function>
		</fcs_function>
		
		<pure_gain name="/systems/pressurization/overpressure-relief-psi-rate">
			<input>/systems/pressurization/relief-valves/overpressure-valve</input>
			<gain>-0.009</gain>
			<clipto>
				<min>-0.04</min>
				<max>0</max>
			</clipto>
		</pure_gain>
		
		<pure_gain name="/systems/pressurization/underpressure-relief-psi-rate">
			<input>/systems/pressurization/relief-valves/underpressure-valve</input>
			<gain>-0.081</gain>
			<clipto>
				<min>-0.36</min>
				<max>0</max>
			</clipto>
		</pure_gain>
		
		<fcs_function name="/systems/pressurization/pack-psi">
			<function>
				<sum>
					<min>
						<property>/systems/pressurization/cabin-psi</property>
						<value>15.82</value>
					</min>
					<value>4</value>
				</sum>
			</function>
		</fcs_function>
		
		<summer name="/systems/pressurization/pack-flow-sum">
			<input>/systems/pneumatics/pack-1-flow</input>
			<input>/systems/pneumatics/pack-2-flow</input>
			<input>/systems/pneumatics/pack-3-flow</input>
			<clipto>
				<min>0</min>
				<max>24</max>
			</clipto>
		</summer>
		
		<summer name="/systems/pressurization/pack-psi-error">
			<input>/systems/pressurization/cabin-psi</input>
			<input>-/systems/pressurization/pack-psi</input>
			<clipto> <!-- It can never depressurize -->
				<min>-100</min>
				<max>0</max>
			</clipto>
		</summer>
		
		<fcs_function name="/systems/pressurization/pack-psi-rate">
			<function>
				<product>
					<difference>
						<value>1</value>
						<pow> <!-- Flow isn't linear -->
							<property>/systems/pressurization/outflow-valve/pos</property>
							<value>2</value>
						</pow>
					</difference>
					<table>
						<independentVar lookup="row">/systems/pressurization/pack-flow-sum</independentVar>
						<tableData>
							 0  0
							24  1
						</tableData>
					</table>
					<value>-0.004</value>
				</product>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cabin-psi-calc">
			<function>
				<sum>
					<property>/systems/pressurization/cabin-psi</property>
					<product> <!-- Leakage factor -->
						<property>/systems/pressurization/cabin-diff-psi</property>
						<value>-0.00001</value>
						<property>simulation/channel-dt</property>
					</product>
					<product> <!-- Outflow factor -->
						<property>/systems/pressurization/cabin-diff-psi</property>
						<property>/systems/pressurization/outflow-psi-rate</property>
						<property>simulation/channel-dt</property>
					</product>
					<product> <!-- Overpressure relief factor -->
						<property>/systems/pressurization/cabin-diff-psi</property>
						<property>/systems/pressurization/overpressure-relief-psi-rate</property>
						<property>simulation/channel-dt</property>
					</product>
					<product> <!-- Underpressure relief factor -->
						<property>/systems/pressurization/cabin-diff-psi</property>
						<property>/systems/pressurization/underpressure-relief-psi-rate</property>
						<property>simulation/channel-dt</property>
					</product>
					<product> <!-- Packs factor -->
						<property>/systems/pressurization/pack-psi-error</property>
						<property>/systems/pressurization/pack-psi-rate</property>
						<property>simulation/channel-dt</property>
					</product>
				</sum>
			</function>
			<output>/systems/pressurization/cabin-psi</output>
			<clipto> <!-- Keep it reasonable -->
				<min>1</min>
				<max>30</max>
			</clipto>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cabin-alt-ft">
			<function>
				<product>
					<value>145366.45</value>
					<difference>
						<value>1</value>
						<pow>
							<quotient>
								<property>/systems/pressurization/cabin-psi</property>
								<product>
									<property>/instrumentation/altimeter/setting-inhg</property>
									<value>0.4911738</value>
								</product>
							</quotient>
							<value>0.190284</value>
						</pow>
					</difference>
				</product>
			</function>
		</fcs_function>
		
		<fcs_function name="/systems/pressurization/cabin-rate-alt-ft-input">
			<function>
				<product>
					<value>145366.45</value>
					<difference>
						<value>1</value>
						<pow>
							<quotient>
								<property>/systems/pressurization/cabin-psi</property>
								<value>14.6959</value>
							</quotient>
							<value>0.190284</value>
						</pow>
					</difference>
				</product>
			</function>
		</fcs_function>
		
		<pid name="/systems/pressurization/cabin-rate-fps">
			<descripton>Use D only to calculate rate</descripton>
			<input>/systems/pressurization/cabin-rate-alt-ft-input</input> <!-- So that QNH correction does not affect the rate calculation -->
			<kp>0</kp>
			<ki>0</ki>
			<kd>1</kd>
		</pid>
		
		<pure_gain name="/systems/pressurization/cabin-rate-fpm-raw">
			<input>/systems/pressurization/cabin-rate-fps</input>
			<gain>60</gain>
			<clipto> <!-- Keep it sane -->
				<min>-9990</min>
				<max>9990</max>
			</clipto>
		</pure_gain>
		
		<lag_filter name="/systems/pressurization/cabin-rate-fpm">
			<input>/systems/pressurization/cabin-rate-fpm-raw</input>
			<c1>5</c1>
		</lag_filter>
	
	</channel>
	
	<channel name="Overhead/Synoptic Lights">
		
		<switch name="/systems/pressurization/lights/outflow-closed">
			<default value="0"/>
			<test value="1">
				/systems/pressurization/outflow-valve/pos lt 0.001
			</test>
		</switch>
		
		<switch name="/systems/pressurization/lights/rate-exceed-5-sec-cmd">
			<default value="0"/>
			<test logic="OR" value="1">
				/systems/pressurization/cabin-rate-fpm ge 2995
				/systems/pressurization/cabin-rate-fpm le -1495
			</test>
		</switch>
		
		<actuator name="/systems/pressurization/lights/rate-exceed-5-sec">
			<input>/systems/pressurization/lights/rate-exceed-5-sec-cmd</input>
			<rate_limit sense="incr">0.2</rate_limit> <!-- 5 seconds -->
			<rate_limit sense="decr">2</rate_limit> <!-- 0.5 seconds -->
		</actuator>
		
		<switch name="/systems/pressurization/lights/rate-exceed-15-sec-cmd">
			<default value="0"/>
			<test logic="OR" value="1">
				/systems/pressurization/cabin-rate-fpm ge 1495
				/systems/pressurization/cabin-rate-fpm le -745
			</test>
		</switch>
		
		<actuator name="/systems/pressurization/lights/rate-exceed-15-sec">
			<input>/systems/pressurization/lights/rate-exceed-15-sec-cmd</input>
			<rate_limit sense="incr">0.06666666666666666666666666666667</rate_limit> <!-- 15 seconds -->
			<rate_limit sense="decr">2</rate_limit> <!-- 0.5 seconds -->
		</actuator>
	
	</channel>

</system>
